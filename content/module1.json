          "pageNumber": 1,
          "blocks": [
            { "type": "heading", "body": "What Is a Budget?" },
            { "type": "text", "body": "A budget is a plan that helps you decide how to spend and save your money each month. By tracking what comes in (income) and what goes out (expenses), you can make sure you have enough for what matters most." },
            { "type": "image", "src": "/assets/images/coin-icon.png", "alt": "Coin icon" },
            { "type": "callout", "body": "A budget is a plan for your money — not a restriction!" }
          ]
